# worker 설정. 이 파일을 worker/.env로 복사해 값을 채운다.
# worker/.env는 gitignore된다 — INTERNAL_API_KEY가 들어가므로 커밋하지 않는다.
#
# worker는 서버가 아니라 태블릿과 같은 네트워크에 있는 기계에서 돈다.
# adb가 태블릿의 사설 IP에 직접 닿아야 해서 클라우드에서는 실행할 수 없다.

# 서버 주소와 공유 비밀. 키는 서버(Railway) 환경변수의 INTERNAL_API_KEY와 같은 값이다.
CAFESTUDY_SERVER_URL=https://cafestudy-production.up.railway.app
INTERNAL_API_KEY=

# 되돌릴 수 없는 두 스위치. 둘 다 기본은 꺼짐이고, 켤 때만 정확히 'true'로 적는다.
#   ALLOW_SOMOIM_SUBMIT   실제 제출. 서버의 SOMOIM_AUTOMATION_ALLOW_SUBMIT과 둘 다 켜져야 한다.
#   SOMOIM_NOTIFY_MEMBERS 정모 생성 시 클럽 전원 알림. 나간 알림은 되돌릴 수 없다.
ALLOW_SOMOIM_SUBMIT=
SOMOIM_NOTIFY_MEMBERS=

# 태블릿. ADB_SERIAL은 `adb devices`에 뜨는 값이다. 무선 디버깅은 재부팅하면 포트가
#바뀌므로 worker/TABLET_SETUP.md의 고정 포트 절차를 따르는 편이 낫다.
ADB_SERIAL=
ADB_CONNECT_ADDRESS=
ADB_PATH=

# 정모를 만들 클럽. 화면의 이름과 정확히 일치해야 하며, 클럽장이 바꾸면 여기서 맞춘다.
SOMOIM_TARGET_GROUP_NAME=[홍대] it&ai 스터디

# 정모 사진. 앱이 사진 없이는 제출을 받지 않는다. 비우면 단색 16:9 이미지를 만들어 쓴다.
MEETUP_PHOTO_PATH=

# 스크린샷과 uiautomator 덤프가 쌓이는 곳. 서버로 올라가지 않으니 실패 진단은 여기서 한다.
ARTIFACT_DIR=./worker-artifacts

# 폴링 주기(ms)와 중복 실행을 막는 락 파일. 비우면 각각 5000과 OS 임시폴더를 쓴다.
POLL_INTERVAL_MS=
WORKER_LOCK_FILE=

# 최종 실패 알림. 비우면 비활성이다. 재시도 중인 실패·정상 취소·중복 감지는 보내지 않는다.
DISCORD_AUTOMATION_WEBHOOK_URL=
DISCORD_ALERT_TIMEOUT_MS=5000
