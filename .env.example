NODE_ENV=
PORT=
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Browser session (HttpOnly cookie; production defaults to Secure=true)
SESSION_COOKIE_NAME=cafestudy_session
SESSION_COOKIE_SECURE=
SESSION_TTL_SEC=604800
# Legacy bearer auth is disabled in production by default.
ALLOW_BEARER_AUTH=

# Object storage (Cloudflare R2 / AWS S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=
UPLOAD_URL_TTL_SEC=300
VERIFICATION_UPLOAD_MAX_BYTES=5242880
VERIFICATION_UPLOAD_MAX_PENDING=3
VERIFICATION_UPLOAD_MAX_PER_HOUR=10
VERIFICATION_UPLOAD_GC_SCHEDULE=15 * * * *
VERIFICATION_UPLOAD_RETENTION_HOURS=24

# Naver Search API
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Hugging Face badge image generation
HF_TOKEN=
HF_BADGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_BADGE_PROVIDER_PATH=hf-inference
HF_BADGE_ENDPOINT=
BADGE_GENERATION_DAILY_LIMIT=3
BADGE_GENERATION_TIMEOUT_MS=45000
BADGE_GENERATION_MAX_BYTES=5242880
BADGE_GC_SCHEDULE=30 3 * * *

# Somoim sync / automation
INTERNAL_API_KEY=change-me-to-a-secret-value
SYNC_ENDPOINT=http://localhost:3000/api/members/sync
SOMOIM_URL=
CRAWL_SCHEDULE=0 2,18 * * *
REFRESH_COOLDOWN_SEC=300
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_SKIP_DOWNLOAD=
SOMOIM_AUTOMATION_ALLOW_SUBMIT=false
# 모임을 만들 때 자동으로 등록 job을 만든다. ALLOW_SUBMIT이 켜져 있어야 동작한다
SOMOIM_AUTOMATION_AUTO_REGISTER=false
# claim 후 이 시간이 지나도록 결과 보고가 없으면 job을 회수한다 (최소 60)
SOMOIM_AUTOMATION_STALE_CLAIM_SEC=900
# 회수 재시도 횟수를 다 쓰면 needs_manual_review로 넘긴다 (1~10)
SOMOIM_AUTOMATION_MAX_ATTEMPTS=3
